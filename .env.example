# Copy thành .env rồi chỉnh. File .env KHÔNG được commit (đã nằm trong .gitignore).

# --- LLM ---------------------------------------------------------------
# mock           : chạy offline, không cần key (kịch bản cố định, để dev pipeline/UI)
# openai_compat  : mọi endpoint theo chuẩn OpenAI /chat/completions có tool calling
LLM_PROVIDER=mock

# Chỉ cần khi LLM_PROVIDER=openai_compat
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=ten-model-ban-dung
# LLM_TIMEOUT_SECONDS=120   # Modal cold start có thể lâu
# LLM_MAX_TOKENS=256
# LLM_EXTRA_HEADERS={"Modal-Key":"wk-...","Modal-Secret":"ws-..."}   # nếu bật Modal proxy auth
# LLM_TEMPERATURE=0        # bỏ trống nếu model không cho chỉnh temperature

# --- Dữ liệu & agent ---------------------------------------------------
# DATA_DIR=data
# MAX_UPLOAD_MB=20
# MAX_RESULT_ROWS=200
# SQL_TIMEOUT_SECONDS=10
# AGENT_MAX_STEPS=6
# HISTORY_TURNS=6

# --- CORS (frontend dev server), ngăn cách bằng dấu phẩy ---------------
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173
